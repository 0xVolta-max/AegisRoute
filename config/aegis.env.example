# ==========================================================
# AegisRoute Environment Configuration Template
# Copy to .env and adjust your parameters
# ==========================================================

# Google Colab Target Notebook URL
AEGIS_COLAB_URL=https://colab.research.google.com/drive/YOUR_NOTEBOOK_ID

# Persistent Browser Profile Directory for Playwright
AEGIS_USER_DATA_DIR=./colab_user_data

# Active Inference Bridge Tunnel Base URL
AEGIS_TUNNEL_URL=http://localhost:8000/v1

# OmniRoute Admin Update Webhook Callback URL
AEGIS_TUNNEL_CALLBACK_URL=http://localhost:20128/aegis/update-tunnel

# Alerting Webhooks
AEGIS_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN
AEGIS_N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/aegis-alert
AEGIS_ENABLE_MACOS_NOTIFICATIONS=true

# Circuit Breaker Configuration
AEGIS_COOLDOWN_HOURS=4.0
AEGIS_HEALTH_INTERVAL_SECONDS=30

# Strix / CI Endpoint Base URL
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=aegis-internal
